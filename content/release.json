                  "citation": "Transparent Language Pashto phrase resource"
                },
                {
                  "id": "ps-itm-b85207",
                  "native": "د خدای په امان",
                  "romanisation": "Da Khuday pa aman",
                  "meaning": "Goodbye",
                  "context": "It is time to leave. Say goodbye.",
                  "usage_note": "Literally \"in God's protection\". Warm and ordinary rather than formal.",
                  "variety": "ps-var-yusufzai",
                  "citation": "Transparent Language Pashto phrase resource"
                },
                {
                  "id": "ps-itm-3ac9f4",
                  "native": "څنګه یې؟",
                  "romanisation": "Tsanga ye?",
                  "meaning": "How are you?",
                  "context": "Ask a friend how they are.",
                  "usage_note": "The informal singular. A respectful or plural form differs.",
                  "variety": "ps-var-yusufzai",
                  "citation": "Transparent Language Pashto phrase resource"
