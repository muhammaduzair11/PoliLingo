                {
                  "id": "ps-itm-7f3a91",
                  "native": "سلام",
                  "romanisation": "Salaam",
                  "meaning": "Hello",
                  "context": "Greet someone you have just met.",
                  "usage_note": "The short everyday greeting. The fuller form السلام علیکم is used in more formal situations and is shared across several Pakistani languages.",
                  "variety": "ps-var-yusufzai",
                  "citation": "Transparent Language Pashto phrase resource"
                },
                {
                  "id": "ps-itm-1d64e0",
                  "native": "مننه",
                  "romanisation": "Manana",
                  "meaning": "Thank you",
                  "context": "Someone helps you. Thank them.",
