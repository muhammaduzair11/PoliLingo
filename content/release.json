            {
              "id": "ps-lsn-4e17b8",
              "order": 2,
              "title": "You, in a new language",
              "subtitle": "Names, introductions, and first friends.",
              "objective": "Say your own name, ask someone else's, say that you are well, and say where you are from.",
              "variety": "ps-var-yusufzai",
              "items": [
                {
                  "id": "ps-itm-5e20d7",
                  "native": "زما نوم سارا دی",
                  "romanisation": "Zma num Sara day",
                  "meaning": "My name is Sara",
                  "context": "Introduce yourself as Sara.",
                  "usage_note": "Replace Sara with your own name. The final دی agrees with the speaker; a form for a female speaker may differ.",
                  "variety": "ps-var-yusufzai",
                  "citation": "Transparent Language Pashto phrase resource; the name Sara inserted into a sourced template"
                },
                {
                  "id": "ps-itm-92c14b",
                  "native": "ستاسې نوم څه دی؟",
                  "romanisation": "Stase num tsa day?",
                  "meaning": "What is your name?",
                  "context": "Ask someone their name politely.",
                  "usage_note": "ستاسې is the respectful or plural \"your\".",
                  "variety": "ps-var-yusufzai",
                  "citation": "Transparent Language Pashto phrase resource"
                },
                {
                  "id": "ps-itm-0f6a83",
                  "native": "زه ښه یم",
                  "romanisation": "Za kha yam",
                  "meaning": "I am fine",
                  "context": "Someone asks how you are. Say you are fine.",
                  "usage_note": "ښه is read here with the Northern \"kh\" value, which is the variety this course teaches. A Kandahari speaker would say it differently.",
                  "variety": "ps-var-yusufzai",
                  "citation": "Transparent Language Pashto phrase resource"
                },
                {
                  "id": "ps-itm-d471ce",
                  "native": "زه د پاکستان یم",
                  "romanisation": "Za da Pakistan yam",
                  "meaning": "I am from Pakistan",
                  "context": "Tell someone where you are from.",
                  "usage_note": "Substitute another place name as needed.",
                  "variety": "ps-var-yusufzai",
                  "citation": "Transparent Language Pashto phrase resource; the country name inserted into a sourced template"
                }
